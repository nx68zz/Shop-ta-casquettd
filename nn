  margin-bottom: .2rem;
}
.cart-item-price { font-size: .85rem; color: var(--gold); font-weight: 600; }

.qty-controls {
  display: flex; align-items: center; gap: .6rem; margin-top: .5rem;
}
.qty-btn {
  background: #222; border: none;
  color: var(--white);
