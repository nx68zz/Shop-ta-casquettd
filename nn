<script>
  const PRODUCTS = [
    { id:1, name:'OG Snapback', cat:'snapback', emoji:'🧢', price:34.90, badge:'hot', desc:'Coton premium, ajusteur métal, visière plate.' },
    { id:2, name:'Vintage Wash', cat:'fitted', emoji:'🎩', price:42.00, old:55.00, badge:'new', desc:'Effet délavé authentique, broderie 3D.' },
    { id:3, name:'Mesh Trucker', cat:'trucker', emoji:'👒', price:29.90, badge:null, desc:'Dos filet respirant, parfait pour l'été.' },
    { id:4, name:'Black Label', cat:'snapback', emoji:'⬛', price:39.90, badge:'hot', desc:'All-black, logo ton sur ton, visière courbe.' },
    { id:5, name:'Camo Army', cat:'trucker', emoji:'🪖', price:32.00, badge:null, desc:'Motif camouflage, ajusteur clip.' },
    { id:6, name:'Retro Script', cat:'fitted', emoji:'🏆', price:47.50, old:60.00, badge:'new', desc:'Script brodé vintage, laine & polyester.' },
    { id:7, name:'Dad Cap Lin', cat:'fitted', emoji:'🌿', price:36.00, badge:null, desc:'Lin naturel, boucle dorée, silhouette décontractée.' },
    { id:8, name:'Neon Edge', cat:'snapback', emoji:'⚡', price:38.00, badge:'hot', desc:'Bord néon fluo, logo réfléchissant nuit.' },
    { id:9, name:'Corduroy Co.', cat:'fitted', emoji:'🟫', price:44.00, badge:'new', desc:'Velours côtelé chocolat, broderie crème.' },
    { id:10, name:'Sport Pro', cat:'trucker', emoji:'🏃', price:27.90, badge:null, desc:'Technologie DryFit, légère et robuste.' },
    { id:11, name:'Floral Bloom', cat:'snapback', emoji:'🌸', price:35.50, badge:'new', desc:'Patch floral brodé, coloris pastels.' },
    { id:12, name:'Classic 5-Panel', cat:'trucker', emoji:'🔵', price:31.00, badge:null, desc:'5 panneaux, couture centrale, look skate.' },
  ];

  let cart = {};
  let currentFilter = 'all';

  function filterProducts(cat, el) {
    currentFilter = cat;
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    renderProducts();
  }

  function renderProducts() {
    const grid = document.getElementById('productsGrid');
    const filtered = currentFilter === 'all' ? PRODUCTS : PRODUCTS.filter(p => p.cat === currentFilter);
    grid.innerHTML = filtered.map(p => `
      <div class="product-card" data-id="${p.id}">
        <div class="product-img">
          ${p.badge ? `<span class="badge badge-${p.badge}">${p.badge === 'new' ? 'NOUVEAU' : p.badge === 'hot' ? '🔥 TENDANCE' : 'ÉPUISÉ'}</span>` : ''}
          <span>${p.emoji}</span>
        </div>
        <div class="product-info">
          <p class="product-cat">${p.cat}</p>
          <p class="product-name">${p.name}</p>
          <p class="product-desc">${p.desc}</p>
          <div class="product-footer">
            <div class="product-price">
              ${p.price.toFixed(2).replace('.',',')} €
              ${p.old ? `<span class="old">${p.old.toFixed(2).replace('.',',')} €</span>` : ''}
            </div>
            <button class="add-btn" title="Ajouter au panier" onclick="addToCart(${p.id})">+</button>
          </div>
        </div>
      </div>
    `).join('');
  }

  function addToCart(id) {
    const p = PRODUCTS.find(x => x.id === id);
    if (!p) return;
    cart[id] = cart[id] ? { ...cart[id], qty: cart[id].qty + 1 } : { ...p, qty: 1 };
    updateCartUI();
    showToast(`${p.emoji} ${p.name} ajouté !`);
  }

  function removeFromCart(id) {
    delete cart[id];
    updateCartUI();
  }

  function changeQty(id, delta) {
    if (!cart[id]) return;
    cart[id].qty += delta;
    if (cart[id].qty <= 0) delete cart[id];
    updateCartUI();
  }

  function updateCartUI() {
    const items = Object.values(cart);
    const total = items.reduce((s, i) => s + i.price * i.qty, 0);
    const count = items.reduce((s, i) => s + i.qty, 0);

    document.getElementById('cartCount').textContent = count;
    document.getElementById('cartTotal').textContent = total.toFixed(2).replace('.', ',') + ' €';
    document.getElementById('checkoutBtn').disabled = count === 0;

    const container = document.getElementById('cartItems');
    if (items.length === 0) {
      container.innerHTML = `<div class="cart-empty"><span>🧢</span><p>Panier vide</p></div>`;
      return;
    }
    container.innerHTML = items.map(i => `
      <div class="cart-item">
        <div class="cart-item-img">${i.emoji}</div>
        <div class="cart-item-info">
          <p class="cart-item-name">${i.name}</p>
          <p class="cart-item-price">${(i.price * i.qty).toFixed(2).replace('.', ',') } €</p>
          <div class="qty-controls">
            <button class="qty-btn" onclick="changeQty(${i.id}, -1)">−</button>
            <span class="qty-num">${i.qty}</span>
            <button class="qty-btn" onclick="changeQty(${i.id}, 1)">+</button>
          </div>
        </div>
        <button class="remove-btn" onclick="removeFromCart(${i.id})">✕ Retirer</button>
      </div>
    `).join('');
  }

  function openCart() {
    document.getElementById('cartDrawer').classList.add('open');
    document.getElementById('overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeCart() {
    document.getElementById('cartDrawer').classList.remove('open');
    document.getElementById('overlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  function checkout() {
    showToast('🎉 Commande en cours... (démo)');
    closeCart();
    setTimeout(() => { cart = {}; updateCartUI(); }, 1800);
  }

  let toastTimer;
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
  }

  // Init
  renderProducts();
</script>

</body>
</html>